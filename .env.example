# ---------------------------------------------------------------------------
# All variables are SERVER-SIDE ONLY. None use the NEXT_PUBLIC_ prefix, so none
# are ever shipped to the browser. Set them in Vercel > Project > Settings >
# Environment Variables, or in .env.local for development.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key. Used for admin sessions; all access is enforced by RLS.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service-role / secret key. Used ONLY by the cron route. Bypasses RLS - keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use 32+ random chars:
#   openssl rand -hex 32
CRON_SECRET=change-me

# Telegram bot (create one with @BotFather; get your chat id from @userinfobot
# or https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot)
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Shown on receipts and in reminders
INSTITUTE_NAME=Your Institute
INSTITUTE_ADDRESS=Street, City, State - PIN
INSTITUTE_PHONE=+91 90000 00000
# Optional absolute URL of this app, used for links in Telegram messages
APP_URL=https://your-app.vercel.app
